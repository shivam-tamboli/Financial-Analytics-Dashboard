PORT=5050
# Required — no fallback. Local: mongodb://127.0.0.1:27017/finance_dashboard
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/finance_dashboard?appName=Cluster0
MONGO_URI=mongodb://127.0.0.1:27017/finance_dashboard
# Required — no fallback. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed frontend origins (no spaces needed, they're trimmed).
# Add your deployed frontend URL alongside localhost once you deploy, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Seed admin credentials (used by `npm run seed`)
SEED_ADMIN_USERNAME=analyst
SEED_ADMIN_PASSWORD=Analyst@123
SEED_ADMIN_NAME=Jordan Rivera
